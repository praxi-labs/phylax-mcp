{
  "name": "@phyi/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Phylax. Lets an assistant verify artifacts before it uses them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "phylax-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "phylax",
    "mcp",
    "model-context-protocol",
    "supply-chain"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@phyi/sdk": "^0.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
